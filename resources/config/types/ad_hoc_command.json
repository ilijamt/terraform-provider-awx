{
  "endpoint": "/api/v2/ad_hoc_commands/",
  "name": "AdHocCommand",
  "type_name": "ad_hoc_command",
  "id_key": "id",
  "enabled": true,
  "pre_state_set_hook_function": "hooks.RequireResourceStateOrOrig",
  "property_overrides": {
    "canceled_on": {
      "use_state_for_unknown": false
    },
    "controller_node": {
      "use_state_for_unknown": false
    },
    "elapsed": {
      "use_state_for_unknown": false
    },
    "execution_node": {
      "use_state_for_unknown": false
    },
    "extra_vars": {
      "type": "json",
      "post_wrap": true
    },
    "failed": {
      "use_state_for_unknown": false
    },
    "finished": {
      "use_state_for_unknown": false
    },
    "forks": {
      "omit_empty": false
    },
    "job_explanation": {
      "use_state_for_unknown": false
    },
    "launch_type": {
      "use_state_for_unknown": false
    },
    "launched_by": {
      "type": "id",
      "use_state_for_unknown": false
    },
    "started": {
      "use_state_for_unknown": false
    },
    "status": {
      "use_state_for_unknown": false
    },
    "work_unit_id": {
      "use_state_for_unknown": false
    }
  },
  "search_fields": [
    {
      "url_suffix": "%d/",
      "name": "by_id",
      "fields": [
        {
          "name": "id"
        }
      ]
    },
    {
      "name": "by_name",
      "url_suffix": "?name__exact=%s",
      "multiple_results": true,
      "fields": [
        {
          "name": "name",
          "url_escape_value": true
        }
      ]
    }
  ]
}
