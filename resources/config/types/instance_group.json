{
  "endpoint": "/api/v2/instance_groups/",
  "name": "InstanceGroup",
  "type_name": "instance_group",
  "id_key": "id",
  "has_object_roles": true,
  "property_overrides": {
    "capacity": {
      "type": "integer"
    },
    "consumed_capacity": {
      "type": "float"
    },
    "instances": {
      "type": "integer"
    },
    "jobs_running": {
      "type": "integer"
    },
    "max_concurrent_jobs": {
      "omit_empty": false
    },
    "max_forks": {
      "omit_empty": false
    },
    "percent_capacity_remaining": {
      "type": "float"
    },
    "pod_spec_override": {
      "no_default": true
    },
    "policy_instance_minimum": {
      "omit_empty": false
    },
    "policy_instance_percentage": {
      "omit_empty": false
    }
  },
  "enabled": true,
  "search_fields": [
    {
      "url_suffix": "%d/",
      "name": "by_id",
      "fields": [
        {
          "name": "id"
        }
      ]
    },
    {
      "name": "by_name",
      "url_suffix": "?name__exact=%s",
      "multiple_results": true,
      "fields": [
        {
          "name": "name",
          "url_escape_value": true
        }
      ]
    }
  ]
}
