      "omit_empty": false
    },
    "LOCAL_PASSWORD_MIN_SPECIAL": {
      "omit_empty": false
    },
    "LOCAL_PASSWORD_MIN_UPPER": {
      "omit_empty": false
    },
    "OAUTH2_PROVIDER": {
      "type": "json"
    },
    "SESSIONS_PER_USER": {
      "omit_empty": false
    },
    "SOCIAL_AUTH_ORGANIZATION_MAP": {
      "type": "json"
    },
    "SOCIAL_AUTH_TEAM_MAP": {
      "type": "json"
    }
  }
